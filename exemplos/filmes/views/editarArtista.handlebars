<h1>Editar Artista</h1>

<form action="/artistas/{{artista.id}}?_method=PUT" method="POST">

  <div>
    <label>Nome do Artista:</label>
    <input type="text" name="nome" value="{{artista.nome}}">
  </div>

  <br>

  <div>
    <label>Ano de Nascimento:</label>
    <input type="number" name="anoNascimento" value="{{artista.anoNascimento}}">
  </div>

  <br>

  <div>
    <label>Nome artístico:</label>
    <input type="text" name="nomeArtistico" value="{{artista.nomeArtistico}}">
  </div>

  <br>

  <div>
    <label>Em atividade?</label>
    <input type="checkbox" name="emAtividade" {{#if artista.emAtividade}}checked{{/if}}>
  </div>
  <br>

  <div>
    <label>Foto:</label>
    <input type="text" name="foto" value="{{artista.foto}}">
  </div>

  <button type="submit">
    Editar
  </button>
  
</form>