<h1>Editar Filme</h1>

<form action="/filmes/{{filme.id}}?_method=PUT" method="POST">

  <div>
    <label>Nome do Filme:</label>
    <input type="text" name="nome" value="{{filme.nome}}">
  </div>

  <br>

  <div>
    <label>Ano:</label>
    <input type="number" name="ano" value="{{filme.ano}}">
  </div>

  <br>

  <div>
    <label>Diretor:</label>
    <select name="diretorId">
      {{#each diretores}}
        <option value="{{this.id}}" {{#if (eq this.id filme.diretorId)}}selected{{/if}}>
          {{this.nome}}
        </option>
      {{/each}}
    </select>
  </div>

  <br>

  <button type="submit">
    Editar
  </button>
</form>